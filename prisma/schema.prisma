generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id         String     @id @default(cuid())
  name       String
  clientName String
  schedules  Schedule[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([name])
}

model Employee {
  id          String             @id @default(cuid())
  name        String
  trade       String
  assignments ScheduleEmployee[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([name])
}

model Equipment {
  id          String              @id @default(cuid())
  name        String
  category    String
  assignments ScheduleEquipment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([name])
}

model Schedule {
  id         String              @id @default(cuid())
  date       String              // YYYY-MM-DD; avoids timezone shifts in daily site schedules
  jobNo      String
  projectId  String
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  timeIn     String              // 24-hour HH:mm site-local time
  timeOut    String
  scope      String              @db.Text
  employees  ScheduleEmployee[]
  equipments ScheduleEquipment[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([date, timeIn])
  @@index([projectId])
}

model ScheduleEmployee {
  scheduleId String
  employeeId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([scheduleId, employeeId])
  @@index([employeeId])
}

model ScheduleEquipment {
  scheduleId  String
  equipmentId String
  schedule    Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([scheduleId, equipmentId])
  @@index([equipmentId])
}
