generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id              String     @id @default(cuid())
  soNo            String     @default("")
  jobNo           String?
  rev             String     @default("")
  clientName      String
  mainCategory    String     @default("")
  subCategory     String     @default("")
  name            String
  descriptions    String     @default("") @db.Text
  contractValue   String     @default("")
  paymentTerms    String     @default("") @db.Text
  status          String     @default("")
  projectInCharge String     @default("")
  schedules       Schedule[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([jobNo, rev])
  @@index([name])
}

model Employee {
  id          String             @id @default(cuid())
  employeeCode String?
  name        String
  designation String
  location    String             @default("")
  category    String             @default("")
  joiningDate String             @default("")
  remarks     String             @default("") @db.Text
  assignments ScheduleEmployee[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([name])
  @@index([employeeCode])
}

model Equipment {
  id             String              @id @default(cuid())
  registrationNo String?
  vehicleType    String
  vehicleDetails String
  limit          String              @default("")
  modelYear      String              @default("")
  remarks        String              @default("") @db.Text
  assignments    ScheduleEquipment[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([vehicleDetails])
  @@index([registrationNo])
}

model Schedule {
  id         String              @id @default(cuid())
  date       String              // YYYY-MM-DD; site-local calendar date
  jobNo      String
  projectId  String
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  timeIn     String              // 24-hour HH:mm site-local time
  timeOut    String
  scope      String              @db.Text
  employees  ScheduleEmployee[]
  equipments ScheduleEquipment[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([date, timeIn])
  @@index([projectId])
}

model ScheduleEmployee {
  scheduleId String
  employeeId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([scheduleId, employeeId])
  @@index([employeeId])
}

model ScheduleEquipment {
  scheduleId  String
  equipmentId String
  schedule    Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([scheduleId, equipmentId])
  @@index([equipmentId])
}
